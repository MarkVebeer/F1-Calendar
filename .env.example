# Server Configuration
PORT=3001
NODE_ENV=production
# Used for the site address, Discord links and the OAuth callback unless they are set below
PUBLIC_URL=https://your-domain.example
# Holds the databases, backups and generated tracks
DATA_DIR=./data
CORS_ORIGIN=*
COOKIE_SECURE=true
PUBLIC_APP_BUTTON_LABEL=F1 oldal megnyitása

# Optional overrides, derived from PUBLIC_URL by default
# FRONTEND_URL=https://your-domain.example
# PUBLIC_APP_URL=https://your-domain.example
# DISCORD_REDIRECT_URI=https://your-domain.example/api/discord/callback

# Admin Configuration
ADMIN_USERNAME=change-me-admin
ADMIN_PASSWORD=change-me-strong-password

# Discord Bot Configuration
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_BOT_STATUS=online
DISCORD_BOT_ACTIVITY_TYPE=WATCHING
DISCORD_BOT_ACTIVITY_TEXT=f1.markveber.hu

# Meteoblue Weather API
METEOBLUE_API_KEY=your_meteoblue_api_key_here

# Optional: where generated circuit data is stored (default: <DATA_DIR>/tracks)
# TRACK_DATA_DIR=/var/lib/f1-calendar/tracks